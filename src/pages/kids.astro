---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';

const base = import.meta.env.BASE_URL;

const rejected = new Set(['😒', '🤢']);

const recipes = (await getCollection('recipes', (r) => !r.data.draft))
  .filter((r) => {
    const { ratings } = r.data;
    if (!ratings || Object.keys(ratings).length === 0) return false;
    return !Object.values(ratings).some((emoji) => rejected.has(emoji));
  })
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Voor de kids">
  <a href={base} class="back-link">← Alle recepten</a>
  <h1>Voor de kids <span class="count">({recipes.length})</span></h1>
  <p class="subtitle">Recepten die Emma en Annemijn goedkeuren — geen 😒 of 🤢.</p>
  {recipes.length > 0 ? (
    <div class="recipe-grid">
      {recipes.map((recipe) => <RecipeCard recipe={recipe} base={base} />)}
    </div>
  ) : (
    <p class="empty">Nog geen goedgekeurde recepten — voeg beoordelingen toe aan recepten om ze hier te zien.</p>
  )}
</Base>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: #888;
    text-decoration: none;
    font-size: 0.9em;
  }

  .back-link:hover { color: #b85c38; }

  .count {
    font-weight: 400;
    color: #888;
    font-size: 0.85em;
  }

  .subtitle {
    color: #666;
    margin: -0.5rem 0 1.5rem;
    font-size: 0.95em;
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .recipe-grid { grid-template-columns: 1fr; }
  }

  .empty {
    color: #888;
    padding: 2rem 0;
  }
</style>
