---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', (r) => !r.data.draft);
  const categories = [...new Set(recipes.map((r) => r.id.split('/')[0]))];
  return categories.map((category) => ({
    params: { category },
    props: {
      recipes: recipes
        .filter((r) => r.id.split('/')[0] === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category } = Astro.params;
const { recipes } = Astro.props;
const base = import.meta.env.BASE_URL;
const heading = category.charAt(0).toUpperCase() + category.slice(1);
---

<Base
  title={heading}
  breadcrumbs={[{ label: 'Recepten', href: base }, { label: category }]}
>
  <h1>{heading} <span class="count">({recipes.length})</span></h1>
  <div class="recipe-grid">
    {recipes.map((recipe) => <RecipeCard recipe={recipe} base={base} />)}
  </div>
</Base>

<style>
  .count {
    font-weight: 400;
    color: #888;
    font-size: 0.85em;
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 480px) {
    .recipe-grid { grid-template-columns: 1fr; }
  }
</style>
