---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

const recipes = (await getCollection('recipes', (r) => !r.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function totalTime(prepTime: number, cookTime?: number): string {
  return `${prepTime + (cookTime ?? 0)} min`;
}

const ratingNames: Record<string, string> = { emma: 'Emma', annemijn: 'Annemijn' };
---

<Base title="Recepten">
  <h1>Recepten</h1>
  <div class="recipe-grid">
    {recipes.map((recipe) => {
      const category = recipe.id.split('/')[0];
      const ratings = recipe.data.ratings
        ? Object.entries(recipe.data.ratings)
        : [];
      return (
        <a href={`${base}/${recipe.id}/`} class="recipe-card">
          <div class="card-meta">
            <span class="card-category">{category}</span>
            <span class="card-time">{totalTime(recipe.data.prepTime, recipe.data.cookTime)}</span>
          </div>
          <div class="card-title">{recipe.data.title}</div>
          {recipe.data.tags.length > 0 && (
            <div class="card-tags">
              {recipe.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
          {ratings.length > 0 && (
            <div class="card-ratings">
              {ratings.map(([key, emoji]) => (
                <span>{ratingNames[key] ?? key} {emoji}</span>
              ))}
            </div>
          )}
        </a>
      );
    })}
  </div>
</Base>

<style>
  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 480px) {
    .recipe-grid {
      grid-template-columns: 1fr;
    }
  }

  .recipe-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e8e4df;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .recipe-card:hover {
    border-color: #b85c38;
    box-shadow: 0 2px 8px rgba(184, 92, 56, 0.1);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8em;
    color: #888;
  }

  .card-category {
    text-transform: lowercase;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag {
    background: #f0ece6;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.78em;
    color: #555;
  }

  .card-ratings {
    display: flex;
    gap: 0.75rem;
    font-size: 0.85em;
    color: #555;
    margin-top: auto;
    padding-top: 0.25rem;
  }
</style>
