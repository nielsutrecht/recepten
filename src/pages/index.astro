---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

const recipes = (await getCollection('recipes', (r) => !r.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function totalTime(prepTime: number, cookTime?: number): string {
  const total = prepTime + (cookTime ?? 0);
  return `${total} min`;
}
---

<Base title="Recepten">
  <h1>Recepten</h1>
  <ul style="list-style: none; padding: 0; margin: 0;">
    {recipes.map((recipe) => (
      <li style="padding: 0.75rem 0; border-bottom: 1px solid #e8e4df;">
        <a href={`${base}/${recipe.id}/`} style="font-weight: 600; color: #b85c38; text-decoration: none;">
          {recipe.data.title}
        </a>
        <span style="margin-left: 0.75rem; color: #888; font-size: 0.9em;">
          {totalTime(recipe.data.prepTime, recipe.data.cookTime)}
        </span>
      </li>
    ))}
  </ul>
</Base>
