---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base
  title="Sous Vide tijden"
  breadcrumbs={[{ label: 'Recepten', href: base }, { label: 'Sous Vide' }]}
>
  <h1>Sous Vide tijden</h1>
  <p class="subtitle">Temperaturen en tijden als referentie. Altijd direct daarna afbranden op hoog vuur voor een goudbruin korstje.</p>

  <section>
    <h2>Rundvlees</h2>
    <table>
      <thead>
        <tr><th>Product</th><th>Gaarheid</th><th>Temp.</th><th>Tijd</th></tr>
      </thead>
      <tbody>
        <tr><td>Biefstuk</td><td>Rare</td><td>54 °C</td><td>1–4 uur</td></tr>
        <tr><td>Biefstuk</td><td>Medium-rare</td><td>57 °C</td><td>1–4 uur</td></tr>
        <tr><td>Biefstuk</td><td>Medium</td><td>60 °C</td><td>1–4 uur</td></tr>
        <tr><td>Biefstuk</td><td>Well done</td><td>65 °C</td><td>1–4 uur</td></tr>
        <tr><td>Hamburger</td><td>Medium-rare</td><td>57 °C</td><td>45 min–2 uur</td></tr>
        <tr><td>Short rib / pulled beef</td><td>—</td><td>74 °C</td><td>24–48 uur</td></tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Varkensvlees</h2>
    <table>
      <thead>
        <tr><th>Product</th><th>Gaarheid</th><th>Temp.</th><th>Tijd</th></tr>
      </thead>
      <tbody>
        <tr><td>Varkenshaas</td><td>Rosé</td><td>57 °C</td><td>1–2 uur</td></tr>
        <tr><td>Varkenslende</td><td>Gaar</td><td>60 °C</td><td>1–4 uur</td></tr>
        <tr><td>Spareribs</td><td>—</td><td>74 °C</td><td>24–36 uur</td></tr>
        <tr><td>Pulled pork</td><td>—</td><td>74 °C</td><td>24–36 uur</td></tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Kip</h2>
    <table>
      <thead>
        <tr><th>Product</th><th>Gaarheid</th><th>Temp.</th><th>Tijd</th></tr>
      </thead>
      <tbody>
        <tr><td>Kipfilet</td><td>Sappig</td><td>63 °C</td><td>1–4 uur</td></tr>
        <tr><td>Kippendij (zonder bot)</td><td>Gaar</td><td>74 °C</td><td>2–4 uur</td></tr>
        <tr><td>Kippendij (met bot)</td><td>Gaar</td><td>74 °C</td><td>3–6 uur</td></tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Vis</h2>
    <table>
      <thead>
        <tr><th>Product</th><th>Gaarheid</th><th>Temp.</th><th>Tijd</th></tr>
      </thead>
      <tbody>
        <tr><td>Zalm</td><td>Medium</td><td>52 °C</td><td>30–45 min</td></tr>
        <tr><td>Kabeljauw</td><td>Gaar</td><td>55 °C</td><td>30–45 min</td></tr>
        <tr><td>Tonijn</td><td>Medium-rare</td><td>43 °C</td><td>30–45 min</td></tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Eieren</h2>
    <table>
      <thead>
        <tr><th>Product</th><th>Resultaat</th><th>Temp.</th><th>Tijd</th></tr>
      </thead>
      <tbody>
        <tr><td>Ei</td><td>Zacht (vloeibaar dooier)</td><td>63 °C</td><td>45 min</td></tr>
        <tr><td>Ei</td><td>Pocheerbaar</td><td>65 °C</td><td>1 uur</td></tr>
        <tr><td>Ei</td><td>Hard</td><td>71 °C</td><td>1 uur</td></tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Groente</h2>
    <table>
      <thead>
        <tr><th>Product</th><th>Resultaat</th><th>Temp.</th><th>Tijd</th></tr>
      </thead>
      <tbody>
        <tr><td>Wortel</td><td>Beetgaar</td><td>85 °C</td><td>1 uur</td></tr>
        <tr><td>Aardappel</td><td>Gaar</td><td>85 °C</td><td>1–2 uur</td></tr>
        <tr><td>Asperge</td><td>Beetgaar</td><td>85 °C</td><td>15–30 min</td></tr>
        <tr><td>Broccoli</td><td>Beetgaar</td><td>85 °C</td><td>30–45 min</td></tr>
      </tbody>
    </table>
  </section>
</Base>

<style>
  h1 {
    margin-bottom: 0.25rem;
  }

  .subtitle {
    color: #666;
    margin: 0 0 2rem;
    font-size: 0.95em;
  }

  section {
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: #b85c38;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }

  th {
    text-align: left;
    font-weight: 600;
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #888;
    border-bottom: 2px solid #e8e4df;
    padding: 0.4rem 0.75rem 0.4rem 0;
  }

  td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid #f0ede9;
    vertical-align: top;
  }

  tr:last-child td {
    border-bottom: none;
  }

  td:nth-child(3),
  th:nth-child(3) {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  td:nth-child(4),
  th:nth-child(4) {
    white-space: nowrap;
  }
</style>
