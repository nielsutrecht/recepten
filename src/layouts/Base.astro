---
interface Props {
  title: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const { title, breadcrumbs } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.6;
        background: #faf9f7;
        color: #1a1a1a;
      }

      header {
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid #e8e4df;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .site-title {
        text-decoration: none;
        color: inherit;
        font-weight: 600;
        font-size: 1.05rem;
        flex-shrink: 0;
      }

      nav {
        display: flex;
        gap: 1.25rem;
        align-items: center;
        flex-shrink: 0;
      }

      nav a {
        text-decoration: none;
        color: #666;
        font-size: 0.9rem;
        white-space: nowrap;
      }

      nav a:hover {
        color: #b85c38;
      }

      .breadcrumb {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85em;
        color: #888;
        margin-bottom: 1.25rem;
      }

      .breadcrumb a {
        color: #888;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        color: #b85c38;
        text-decoration: underline;
      }

      .breadcrumb-sep {
        color: #ccc;
      }

      .breadcrumb-current {
        color: #444;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
    </style>

    <style is:global>
      @media print {
        header,
        .breadcrumb,
        .filter-bar,
        #tag-chips,
        .back-link,
        .no-results,
        .servings-scaler button,
        #btn-minus,
        #btn-plus {
          display: none !important;
        }

        body {
          background: #fff;
          font-size: 12pt;
          color: #000;
        }

        main {
          max-width: 100%;
          padding: 0;
        }

        a { color: inherit; text-decoration: none; }

        .recipe-card {
          box-shadow: none !important;
          border: 1px solid #ccc !important;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a href={base} class="site-title">Recepten</a>
      <nav>
        <a href={`${base}/kids/`}>Voor de kids</a>
        <a href={`${base}/planner/`}>Weekplanner</a>
      </nav>
    </header>

    <main>
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="breadcrumb">
          {breadcrumbs.map((crumb, i) => (
            <>
              {i > 0 && <span class="breadcrumb-sep">›</span>}
              {crumb.href
                ? <a href={crumb.href}>{crumb.label}</a>
                : <span class="breadcrumb-current">{crumb.label}</span>
              }
            </>
          ))}
        </div>
      )}
      <slot />
    </main>
  </body>
</html>
