---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.6;
        background: #faf9f7;
        color: #1a1a1a;
      }

      header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e8e4df;
      }

      header a {
        text-decoration: none;
        color: inherit;
        font-weight: 600;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
    </style>
  </head>
  <body>
    <header>
      <a href={base}>Recepten</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
