---
import type { CollectionEntry } from 'astro:content';

interface Props {
  recipe: CollectionEntry<'recipes'>;
  base: string;
}

const { recipe, base } = Astro.props;
const { data } = recipe;
const category = recipe.id.split('/')[0];
const ratings = data.ratings ? Object.entries(data.ratings) : [];
const ratingNames: Record<string, string> = { emma: 'Emma', annemijn: 'Annemijn' };

function totalTime(prepTime: number, cookTime?: number): string {
  return `${prepTime + (cookTime ?? 0)} min`;
}
---

<div
  class="recipe-card"
  data-title={data.title.toLowerCase()}
  data-tags={data.tags.join(',')}
  data-category={category}
>
  <div class="card-meta">
    <a href={`${base}/categorie/${category}/`} class="card-category">{category}</a>
    <span class="card-time">{totalTime(data.prepTime, data.cookTime)}</span>
  </div>
  <a href={`${base}/${recipe.id}/`} class="card-title-link">{data.title}</a>
  {data.tags.length > 0 && (
    <div class="card-tags">
      {data.tags.map((tag) => (
        <a href={`${base}/tag/${tag}/`} class="tag">{tag}</a>
      ))}
    </div>
  )}
  {ratings.length > 0 && (
    <div class="card-ratings">
      {ratings.map(([key, emoji]) => (
        <span>{ratingNames[key] ?? key} {emoji}</span>
      ))}
    </div>
  )}
</div>

<style>
  .recipe-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e8e4df;
    border-radius: 8px;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .recipe-card:hover {
    border-color: #b85c38;
    box-shadow: 0 2px 8px rgba(184, 92, 56, 0.1);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8em;
    color: #888;
  }

  .card-category {
    text-transform: lowercase;
    color: #888;
    text-decoration: none;
  }

  .card-category:hover {
    color: #b85c38;
    text-decoration: underline;
  }

  .card-time {
    color: #888;
  }

  .card-title-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
    line-height: 1.3;
  }

  .card-title-link:hover {
    color: #b85c38;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag {
    background: #f0ece6;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.78em;
    color: #555;
    text-decoration: none;
  }

  .tag:hover {
    background: #e8e0d8;
    color: #333;
  }

  .card-ratings {
    display: flex;
    gap: 0.75rem;
    font-size: 0.85em;
    color: #555;
    margin-top: auto;
    padding-top: 0.25rem;
  }
</style>
